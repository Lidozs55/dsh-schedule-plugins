{
  "name": "@lidozs55/dsh-schedule-gacha",
  "version": "0.2.0",
  "description": "Gacha preview source for the DSH schedule core: version updates and preview-stream times for six games, written into the main schedule.",
  "license": "MIT",
  "author": "Lidozs55",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lidozs55/dsh-schedule-plugins.git",
    "directory": "dsh-plugin/dsh-schedule-gacha"
  },
  "bugs": "https://github.com/Lidozs55/dsh-schedule-plugins/issues",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "gacha",
    "schedule"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test"
  },
  "files": [
    "*.js",
    "host/",
    "cordis.patch.yml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@lidozs55/dsh-schedule"
      ]
    }
  },
  "peerDependencies": {
    "@lidozs55/dsh-schedule": "^0.3.0"
  }
}
